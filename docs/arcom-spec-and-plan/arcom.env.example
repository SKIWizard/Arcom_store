# SAMPLE ONLY — never commit real values
SPRING_PROFILES_ACTIVE=prod
APP_PUBLIC_BASE_URL=https://arcom.example
API_PUBLIC_BASE_URL=https://arcom.example/api/v1

# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/arcom
DB_USERNAME=arcom
DB_PASSWORD=REPLACE_WITH_STRONG_SECRET

# Initial admin account — bootstrap via one-time migration/command, never log password
ADMIN_USERNAME=owner
ADMIN_INITIAL_PASSWORD=REPLACE_AND_ROTATE_AFTER_FIRST_LOGIN

# Telegram Bot API — new channel posts
TELEGRAM_BOT_TOKEN=REPLACE_FROM_BOTFATHER
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_URL_SAFE_STRING
TELEGRAM_WEBHOOK_PUBLIC_URL=https://arcom.example/api/v1/integrations/telegram/webhook
TELEGRAM_ALBUM_SETTLE_MS=4000

# GigaChat API — server-side only
GIGACHAT_AUTH_KEY=REPLACE_WITH_AUTHORIZATION_KEY
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=REPLACE_WITH_AVAILABLE_MODEL
AI_AUTOPUBLISH_ENABLED=false
AI_MIN_CONFIDENCE=0.90

# S3 / MinIO
S3_ENDPOINT=https://storage.example
S3_REGION=us-east-1
S3_BUCKET=arcom-images
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_PUBLIC_BASE_URL=https://cdn.arcom.example

# OPTIONAL: read OLD posts only; do not deploy Telethon without explicit owner permission
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_PATH=
